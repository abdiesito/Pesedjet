<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pesedjet.Client.ViewModels"
             xmlns:loc="using:Pesedjet.Client.Utilities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
             x:Class="Pesedjet.Client.Views.FriendsView"
             x:DataType="vm:FriendsViewModel"
             x:CompileBindings="False"
             Background="{DynamicResource ColorBackground}">

    <Design.DataContext>
        <vm:FriendsViewModel/>
    </Design.DataContext>
    
    <Border Background="{DynamicResource ColorSurface}"
            BorderBrush="{DynamicResource ColorBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusCard}"
            Margin="35"
            Padding="30">

        <Grid RowDefinitions="Auto, Auto, *">
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, 320" Margin="0,0,0,20">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Classes="outline-btn"
                            Content="&lt;"
                            Command="{Binding GoBackCommand}"
                            FontSize="18"
                            FontWeight="Bold"
                            Width="38"
                            Height="38"
                            Padding="0"/>
        
                    <TextBlock Text="{Binding [FriendsListSection.FriendsListMessage], Source={x:Static loc:LocalizationManager.Instance}}"
                               Foreground="{DynamicResource ColorTextPrimary}"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <TextBox Width="200"
                             Watermark="{Binding [NewFriend.NewFriendMessage], Source={x:Static loc:LocalizationManager.Instance}}"
                             CornerRadius="{DynamicResource RadiusSmall}"
                             BorderBrush="{DynamicResource ColorBorderFocus}"
                             FontSize="{DynamicResource FontSizeBody}"
                             VerticalContentAlignment="Center"/>
                    <Button Classes="primary-btn"
                            Content="{Binding [NewFriend.AddFriend], Source={x:Static loc:LocalizationManager.Instance}}"/>
                </StackPanel>
            </Grid>
            
            <Border Grid.Row="1" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0,0,0,1" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton Classes="tab-btn"
                                 GroupName="SocialTabs"
                                 Content="{Binding [FriendsSection.AddedFriends], Source={x:Static loc:LocalizationManager.Instance}}"
                                 IsChecked="True"/>
                    <RadioButton Classes="tab-btn"
                                 GroupName="SocialTabs"
                                 Content="{Binding [Menu.FriendsRequest], Source={x:Static loc:LocalizationManager.Instance}}"/>
                    <RadioButton Classes="tab-btn"
                                 GroupName="SocialTabs"
                                 Content="{Binding [FriendsSection.BlockedPlayers], Source={x:Static loc:LocalizationManager.Instance}}"/>
                </StackPanel>
            </Border>
            
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    
                    <Border Background="{DynamicResource ColorBackground}"
                            BorderBrush="{DynamicResource ColorBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="14,10">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource ColorSuccess}"/>
                                <TextBlock Text="@casimerito900pro"
                                           Foreground="{DynamicResource ColorTextPrimary}"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Classes="outline-btn" Content="{Binding [FriendsListSection.FriendProfile], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                <Button Classes="outline-btn" Content="{Binding [FriendsListSection.Remove], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                <Button Classes="danger-btn" Content="{Binding [FriendsListSection.Block], Source={x:Static loc:LocalizationManager.Instance}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <Border Background="{DynamicResource ColorBackground}"
                            BorderBrush="{DynamicResource ColorBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="14,10">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource ColorWarning}"/>
                                <TextBlock Text="@horus_player"
                                           Foreground="{DynamicResource ColorTextPrimary}"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Classes="primary-btn" Content="{Binding [FriendsListSection.Accept], Source={x:Static loc:LocalizationManager.Instance}}"/>
                                <Button Classes="outline-btn" Content="{Binding [FriendsListSection.Reject], Source={x:Static loc:LocalizationManager.Instance}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <Border Background="{DynamicResource ColorBackground}"
                            BorderBrush="{DynamicResource ColorBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="14,10">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource ColorDangerText}"/>
                                <TextBlock Text="@watashiwawa12"
                                           Foreground="{DynamicResource ColorTextPrimary}"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Classes="outline-btn" Content="{Binding [BlockedPlayersSection.Unblock], Source={x:Static loc:LocalizationManager.Instance}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>

</UserControl>