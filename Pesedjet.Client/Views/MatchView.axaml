<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="600"
             xmlns:loc="using:Pesedjet.Client.Utilities"
             xmlns:vm="using:Pesedjet.Client.ViewModels"
             x:DataType="vm:MatchViewModel"
             x:CompileBindings="False"
             x:Class="Pesedjet.Client.Views.MatchView"
             Background="{DynamicResource ColorBackground}">

    <Border Background="{DynamicResource ColorSurface}"
            BorderBrush="{DynamicResource ColorBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusCard}"
            Margin="40"
            Padding="35">

        <Grid ColumnDefinitions="240, Auto, *">
            
            <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto">
                <Button Grid.Row="0"
                        Background="Transparent"
                        Foreground="{DynamicResource ColorTextSecondary}"
                        FontSize="22"
                        FontWeight="Bold"
                        Padding="6"
                        HorizontalAlignment="Left"
                        Cursor="Hand"
                        Content="&lt;"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="16" Margin="0,0,25,0">
                    <Button Height="50"
                            FontSize="16"
                            Content="{Binding [PlaySection.NewMatch], Source={x:Static loc:LocalizationManager.Instance}}"
                            Command="{Binding ShowCreateSectionCommand}"
                            Classes.primary-btn="{Binding IsCreatingSelected}"
                            Classes.outline-btn="{Binding !IsCreatingSelected}"/>

                    <Button Height="50"
                            FontSize="16"
                            Content="{Binding [PlaySection.JoinMatch], Source={x:Static loc:LocalizationManager.Instance}}"
                            Command="{Binding ShowJoinSectionCommand}"
                            Classes.primary-btn="{Binding !IsCreatingSelected}"
                            Classes.outline-btn="{Binding IsCreatingSelected}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" 
                    Width="1" 
                    Background="{DynamicResource ColorBorder}" 
                    Margin="10,15,35,15"/>

            <ContentControl Grid.Column="2" 
                            Content="{Binding CurrentSection}" 
                            Margin="10,0,10,0"/>
        </Grid>
    </Border>
</UserControl>