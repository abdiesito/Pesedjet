<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             xmlns:loc="using:Pesedjet.Client.Utilities"
             xmlns:vm="using:Pesedjet.Client.ViewModels"
             x:Class="Pesedjet.Client.Views.MyProfileView"
             x:DataType="vm:MyProfileViewModel"
             x:CompileBindings="False"
             Background="{DynamicResource ColorBackground}">

    <Design.DataContext>
        <vm:MyProfileViewModel/>
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,20" Spacing="24" MaxWidth="750" HorizontalAlignment="Center">

            <!-- Title -->
            <TextBlock Text="{Binding [Profile.Title], Source={x:Static loc:LocalizationManager.Instance}}"
                       Foreground="{DynamicResource ColorTextPrimary}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="Bold"/>

            <!-- Header Card: Basic Info & Avatar -->
            <Border Background="{DynamicResource ColorSurface}"
                    BorderBrush="{DynamicResource ColorBorder}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusCard}"
                    Padding="24">
                <Grid ColumnDefinitions="Auto, *, Auto">

                    <!-- Avatar Box -->
                    <Border Grid.Column="0"
                            Width="80"
                            Height="80"
                            CornerRadius="40"
                            Background="{DynamicResource ColorBackground}"
                            BorderBrush="{DynamicResource ColorBorderFocus}"
                            BorderThickness="2"
                            Margin="0,0,20,0">
                        <PathIcon Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                                  Width="40"
                                  Height="40"
                                  Foreground="{DynamicResource ColorTextSecondary}"/>
                    </Border>

                    <!-- Primary Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding Gametag}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ColorTextPrimary}"/>

                        <TextBlock Text="{Binding FullName}"
                                   FontSize="15"
                                   Foreground="{DynamicResource ColorTextSecondary}"/>

                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                            <Border Background="{DynamicResource ColorBackground}"
                                    CornerRadius="4"
                                    Padding="8,3">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding [Profile.Level], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="12"
                                               Foreground="{DynamicResource ColorTextMuted}"/>
                                    <TextBlock Text="{Binding PlayerLevel}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource ColorTextPrimary}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource ColorBackground}"
                                    CornerRadius="4"
                                    Padding="8,3">
                                <TextBlock Text="{Binding RankName}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ColorTextSecondary}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Edit Button -->
                    <Button Grid.Column="2"
                            Classes="outline-btn"
                            Content="{Binding [Profile.ButtonEdit], Source={x:Static loc:LocalizationManager.Instance}}"
                            Command="{Binding EditProfileCommand}"
                            VerticalAlignment="Top"
                            Height="38"
                            Padding="18,0"
                            FontSize="14"/>
                </Grid>
            </Border>

            <!-- Statistics Grid Card -->
            <Border Background="{DynamicResource ColorSurface}"
                    BorderBrush="{DynamicResource ColorBorder}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusCard}"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding [Profile.StatsTitle], Source={x:Static loc:LocalizationManager.Instance}}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource ColorTextPrimary}"/>

                    <Grid ColumnDefinitions="*, *, *">

                        <!-- Stat 1: Matches Played -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource ColorBackground}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="16"
                                Margin="0,0,8,0">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding [Profile.MatchesPlayed], Source={x:Static loc:LocalizationManager.Instance}}"
                                           FontSize="13"
                                           Foreground="{DynamicResource ColorTextMuted}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding MatchesPlayed}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ColorTextPrimary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Stat 2: Matches Won -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource ColorBackground}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="16"
                                Margin="4,0">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding [Profile.MatchesWon], Source={x:Static loc:LocalizationManager.Instance}}"
                                           FontSize="13"
                                           Foreground="{DynamicResource ColorTextMuted}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding MatchesWon}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ColorTextPrimary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Stat 3: Win Rate -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource ColorBackground}"
                                CornerRadius="{DynamicResource RadiusSmall}"
                                Padding="16"
                                Margin="8,0,0,0">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding [Profile.WinRate], Source={x:Static loc:LocalizationManager.Instance}}"
                                           FontSize="13"
                                           Foreground="{DynamicResource ColorTextMuted}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding WinRateDisplay}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource ColorTextPrimary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Personal Data Details Card -->
            <Border Background="{DynamicResource ColorSurface}"
                    BorderBrush="{DynamicResource ColorBorder}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusCard}"
                    Padding="24">
                <StackPanel Spacing="16">
                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *">

                        <!-- Email Address -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,0,16">
                            <TextBlock Text="{Binding [Profile.Email], Source={x:Static loc:LocalizationManager.Instance}}"
                                       FontSize="13"
                                       Foreground="{DynamicResource ColorTextMuted}"/>
                            <TextBlock Text="{Binding Email}"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource ColorTextPrimary}"/>
                        </StackPanel>

                        <!-- Birth Date -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="0,0,0,16">
                            <TextBlock Text="{Binding [Profile.BirthDate], Source={x:Static loc:LocalizationManager.Instance}}"
                                       FontSize="13"
                                       Foreground="{DynamicResource ColorTextMuted}"/>
                            <TextBlock Text="{Binding FormattedBirthDate}"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource ColorTextPrimary}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
