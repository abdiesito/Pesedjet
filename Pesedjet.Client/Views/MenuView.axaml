<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:loc="using:Pesedjet.Client.Services"
             xmlns:vm="using:Pesedjet.Client.ViewModels"
             x:DataType="vm:MenuViewModel"
             x:CompileBindings="False"
             x:Class="Pesedjet.Client.Views.MenuView">

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
            
            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Padding="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="40" Height="40" Fill="LightGray" /> 
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding GameTagUser}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding [Menu.MyLevel], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" Foreground="Gray"/>
                        <TextBlock Text="{Binding [Menu.MyRank], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                    
                    <Button Content="{Binding [Menu.MyProfile], Source={x:Static loc:LocalizationManager.Instance}}" 
                            Background="Transparent" Foreground="DodgerBlue" Cursor="Hand" Padding="5,0"/>
                </StackPanel>
            </Border>

            
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding [Menu.FriendsRequest], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding PendingFriendsRequests, StringFormat='({0})'}" HorizontalAlignment="Right" FontSize="12"/>
                </StackPanel>
                
                <StackPanel>
                    <TextBlock Text="{Binding [Menu.RoomInvitations], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="12" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding PendingRoomInvitations, StringFormat='({0})'}" HorizontalAlignment="Right" FontSize="12"/>
                </StackPanel>
                
                <Button Content="{Binding [Menu.LogOut], Source={x:Static loc:LocalizationManager.Instance}}" 
                        BorderBrush="Black" BorderThickness="1" Background="Transparent"/>
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="1" ColumnDefinitions="*, *" Margin="0,40">
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="15" MaxWidth="300" HorizontalAlignment="Left">
                
                <TextBlock Text="{Binding [Menu.Title], Source={x:Static loc:LocalizationManager.Instance}}" 
                           FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding [Menu.Subtitle], Source={x:Static loc:LocalizationManager.Instance}}" 
                           FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                
                <Button Content="{Binding [Menu.Play], Source={x:Static loc:LocalizationManager.Instance}}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10"/>
                <Button Content="{Binding [Menu.Friends], Source={x:Static loc:LocalizationManager.Instance}}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10"/>
                <Button Content="{Binding [Menu.Leaderboard], Source={x:Static loc:LocalizationManager.Instance}}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10"/>
                <Button Content="{Binding [Menu.Settings], Source={x:Static loc:LocalizationManager.Instance}}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10" Click="OpenSettingsClick"/>
            </StackPanel>
            
            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" CornerRadius="10" Padding="20">
                <Grid>
                    
                </Grid>
            </Border>
        </Grid>

        
        <DockPanel Grid.Row="2" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="v0.1.0" Foreground="Gray"/>
            <Button DockPanel.Dock="Right" Content="{Binding [Menu.GlossaryAndRulesMessage], Source={x:Static loc:LocalizationManager.Instance}}"  Background="Transparent" Foreground="DodgerBlue"/>
        </DockPanel>

    </Grid>
</UserControl>
