<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
             xmlns:loc="using:Pesedjet.Client.Services"
             xmlns:vm="using:Pesedjet.Client.ViewModels"
             x:DataType="vm:MenuViewModel"
             x:CompileBindings="False"
             x:Class="Pesedjet.Client.Views.MenuView"
             Background="{DynamicResource ColorBackground}">

    <Grid RowDefinitions="Auto, *, Auto" Margin="30">
        
        <!-- ========================================== -->
        <!-- Fila 0: Barra superior (Ficha de usuario, Campana y Salir) -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
            
            <!-- Ficha de Usuario -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource ColorSurface}"
                    BorderBrush="{DynamicResource ColorBorder}" 
                    BorderThickness="1" 
                    CornerRadius="{DynamicResource RadiusCard}" 
                    Padding="14,10">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Ellipse Width="44" Height="44" Fill="{DynamicResource ColorBorderFocus}" /> 
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding GameTagUser}" 
                                   Foreground="{DynamicResource ColorTextPrimary}"
                                   FontWeight="Bold"
                                   FontSize="15"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding [Menu.MyLevel], Source={x:Static loc:LocalizationManager.Instance}}" 
                                       FontSize="{DynamicResource FontSizeSmall}" 
                                       Foreground="{DynamicResource ColorTextSecondary}"/>
                            <TextBlock Text="•" 
                                       FontSize="{DynamicResource FontSizeSmall}" 
                                       Foreground="{DynamicResource ColorTextMuted}"/>
                            <TextBlock Text="{Binding [Menu.MyRank], Source={x:Static loc:LocalizationManager.Instance}}" 
                                       FontSize="{DynamicResource FontSizeSmall}" 
                                       Foreground="{DynamicResource ColorTextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <Button Content="{Binding [Menu.MyProfile], Source={x:Static loc:LocalizationManager.Instance}}" 
                            Background="Transparent" 
                            Foreground="{DynamicResource ColorPrimaryHover}" 
                            FontWeight="SemiBold"
                            Cursor="Hand" 
                            Padding="8,4"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Sección derecha: Notificaciones y Cerrar sesión -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                
                <!-- Botón de Notificaciones con Badge numérico -->
                <Grid Width="44" Height="44" Cursor="Hand">
                    <Button Classes="outline-btn"
                            Width="44"
                            Height="44"
                            Padding="0"
                            CornerRadius="{DynamicResource RadiusButton}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Notificaciones">
                        
                        <PathIcon Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"
                                  Width="18"
                                  Height="18"
                                  Foreground="{DynamicResource ColorTextPrimary}"/>
                    </Button>

                    <Border Background="{DynamicResource ColorDangerBackground}"
                            BorderBrush="{DynamicResource ColorDangerBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="5,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-4,-4,0"
                            IsHitTestVisible="False">
                        <TextBlock Text="{Binding PendingFriendsRequests}" 
                                   Foreground="{DynamicResource ColorDangerText}"
                                   FontWeight="Bold"
                                   FontSize="11"/>
                    </Border>
                </Grid>
                
                <!-- Botón de Cerrar Sesión -->
                <Button Classes="danger-btn"
                        Content="{Binding [Menu.LogOut], Source={x:Static loc:LocalizationManager.Instance}}"
                        Height="44"
                        VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>
        
        <!-- ========================================== -->
        <!-- Fila 1: Menú Central y Panel de Arte -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" ColumnDefinitions="320, 40, *" Margin="0,30">
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="14">
                
                <StackPanel Margin="0,0,0,15" Spacing="4">
                    <TextBlock Text="{Binding [Menu.Title], Source={x:Static loc:LocalizationManager.Instance}}" 
                               Foreground="{DynamicResource ColorTextPrimary}"
                               FontSize="40" 
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding [Menu.Subtitle], Source={x:Static loc:LocalizationManager.Instance}}" 
                               Foreground="{DynamicResource ColorTextSecondary}"
                               FontSize="{DynamicResource FontSizeSubtitle}" 
                               FontWeight="Normal"/>
                </StackPanel>
                
                <!-- Botón Jugar (Acción principal destacada en azul sólido) -->
                <Button Classes="primary-btn"
                        Content="{Binding [Menu.Play], Source={x:Static loc:LocalizationManager.Instance}}" 
                        HorizontalAlignment="Stretch"
                        Height="46"
                        FontSize="15"/>

                <!-- Botones Secundarios (Outline) -->
                <Button Classes="outline-btn"
                        Content="{Binding [Menu.Friends], Source={x:Static loc:LocalizationManager.Instance}}" 
                        HorizontalAlignment="Stretch"
                        Height="44"
                        FontSize="15"/>

                <Button Classes="outline-btn"
                        Content="{Binding [Menu.Leaderboard], Source={x:Static loc:LocalizationManager.Instance}}" 
                        HorizontalAlignment="Stretch"
                        Height="44"
                        FontSize="15"/>

                <Button Classes="outline-btn"
                        Content="{Binding [Menu.Settings], Source={x:Static loc:LocalizationManager.Instance}}" 
                        HorizontalAlignment="Stretch"
                        Height="44"
                        FontSize="15"
                        Click="OpenSettingsClick"/>
            </StackPanel>
            
            <Border Grid.Column="2" 
                    Background="{DynamicResource ColorSurface}"
                    BorderBrush="{DynamicResource ColorBorder}" 
                    BorderThickness="1" 
                    CornerRadius="{DynamicResource RadiusCard}" 
                    Padding="25">
                <Grid>
                    <TextBlock Text="Pesedjet"
                               Foreground="{DynamicResource ColorBorder}"
                               FontSize="56"
                               FontWeight="ExtraBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.6"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- Fila 2: Pie de página -->
        <!-- ========================================== -->
        <DockPanel Grid.Row="2" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" 
                       Text="v0.1.0" 
                       Foreground="{DynamicResource ColorTextMuted}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       VerticalAlignment="Center"/>

            <Button DockPanel.Dock="Right" 
                    Content="{Binding [Menu.GlossaryAndRulesMessage], Source={x:Static loc:LocalizationManager.Instance}}"  
                    Background="Transparent" 
                    Foreground="{DynamicResource ColorPrimaryHover}"
                    Cursor="Hand"
                    FontSize="{DynamicResource FontSizeSmall}"
                    FontWeight="Medium"/>
        </DockPanel>

    </Grid>
</UserControl>