<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="600"
             xmlns:loc="using:Pesedjet.Client.Utilities"
             xmlns:vm="using:Pesedjet.Client.ViewModels"
             x:Class="Pesedjet.Client.Views.ForgotPasswordView"
             x:DataType="vm:ForgotPasswordViewModel"
             x:CompileBindings="False"
             Background="{DynamicResource ColorBackground}">

    <Design.DataContext>
        <vm:ForgotPasswordViewModel/>
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Background="{DynamicResource ColorSurface}"
                BorderBrush="{DynamicResource ColorBorder}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusCard}"
                Margin="40,30"
                Padding="40,30"
                MaxWidth="520"
                HorizontalAlignment="Center">

            <Grid RowDefinitions="Auto, Auto, *">

                <!-- Header -->
                <TextBlock Grid.Row="0"
                           Text="{Binding [ForgotPassword.Title], Source={x:Static loc:LocalizationManager.Instance}}"
                           Foreground="{DynamicResource ColorTextPrimary}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- Separator -->
                <Border Grid.Row="1"
                        Height="1"
                        Background="{DynamicResource ColorBorder}"
                        Margin="0,0,0,24"/>

                <!-- Form Content -->
                <StackPanel Grid.Row="2" Spacing="20">

                    <!-- Field 1: Email Input (Step 1) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding [ForgotPassword.InstructionStep1], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Foreground="{DynamicResource ColorTextSecondary}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="{Binding [ForgotPassword.Email], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Foreground="{DynamicResource ColorTextSecondary}"
                                   FontSize="14"
                                   FontWeight="Medium"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0"
                                     Height="42"
                                     Text="{Binding Email}"
                                     Watermark="usuario@dominio.com"
                                     IsEnabled="{Binding !IsCodeSent}"
                                     Classes.input-error="{Binding IsEmailInvalid}"/>

                            <Button Grid.Column="1"
                                    Classes="primary-btn"
                                    Content="{Binding [ForgotPassword.ButtonSendCode], Source={x:Static loc:LocalizationManager.Instance}}"
                                    Command="{Binding SendCodeCommand}"
                                    IsEnabled="{Binding !IsCodeSent}"
                                    Height="42"
                                    Padding="18,0"
                                    Margin="10,0,0,0"
                                    FontSize="14"/>
                        </Grid>
                    </StackPanel>

                    <!-- Step 2: Verification Code & New Password Fields -->
                    <StackPanel Spacing="18" IsVisible="{Binding IsCodeSent}">

                        <Border Height="1" Background="{DynamicResource ColorBorder}" Margin="0,4"/>

                        <TextBlock Text="{Binding [ForgotPassword.InstructionStep2], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Foreground="{DynamicResource ColorTextSecondary}"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>

                        <!-- Field 2: Verification Code -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding [ForgotPassword.Code], Source={x:Static loc:LocalizationManager.Instance}}"
                                       Foreground="{DynamicResource ColorTextSecondary}"
                                       FontSize="14"
                                       FontWeight="Medium"/>
                            <TextBox Width="200"
                                     Height="44"
                                     MaxLength="6"
                                     Text="{Binding VerificationCode}"
                                     Watermark="------"
                                     LetterSpacing="5"
                                     FontSize="18"
                                     FontWeight="Bold"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     HorizontalAlignment="Left"
                                     Classes.input-error="{Binding IsCodeInvalid}"/>
                        </StackPanel>

                        <!-- Field 3 & 4: New Password and Confirmation -->
                        <Grid ColumnDefinitions="*, 14, *">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{Binding [ForgotPassword.NewPassword], Source={x:Static loc:LocalizationManager.Instance}}"
                                           Foreground="{DynamicResource ColorTextSecondary}"
                                           FontSize="14"
                                           FontWeight="Medium"/>
                                <TextBox Height="42"
                                         PasswordChar="●"
                                         Text="{Binding NewPassword}"
                                         Classes.input-error="{Binding IsPasswordInvalid}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Text="{Binding [ForgotPassword.ConfirmPassword], Source={x:Static loc:LocalizationManager.Instance}}"
                                           Foreground="{DynamicResource ColorTextSecondary}"
                                           FontSize="14"
                                           FontWeight="Medium"/>
                                <TextBox Height="42"
                                         PasswordChar="●"
                                         Text="{Binding ConfirmPassword}"
                                         Classes.input-error="{Binding IsConfirmPasswordInvalid}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Error Banner -->
                    <Border Background="#1AE04848"
                            BorderBrush="{DynamicResource ColorDangerText}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSmall}"
                            Padding="12,10"
                            IsVisible="{Binding HasError}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource ColorDangerText}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,10,0,0">
                        <Button Grid.Column="0"
                                Classes="outline-btn"
                                Content="{Binding [ForgotPassword.ButtonCancel], Source={x:Static loc:LocalizationManager.Instance}}"
                                Command="{Binding CancelCommand}"
                                Height="44"
                                Padding="24,0"
                                FontSize="15"/>

                        <Button Grid.Column="2"
                                Classes="primary-btn"
                                Content="{Binding [ForgotPassword.ButtonReset], Source={x:Static loc:LocalizationManager.Instance}}"
                                Command="{Binding ResetPasswordCommand}"
                                IsVisible="{Binding IsCodeSent}"
                                Height="44"
                                Padding="28,0"
                                FontSize="15"/>
                    </Grid>

                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>