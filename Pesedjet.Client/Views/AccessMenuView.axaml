<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="600"
             xmlns:loc="using:Pesedjet.Client.Utilities"
             xmlns:vm="using:Pesedjet.Client.ViewModels"
             x:DataType="vm:AccessMenuViewModel"
             x:CompileBindings="False"
             x:Class="Pesedjet.Client.Views.AccessMenuView"
             Background="{DynamicResource ColorBackground}">

    <ContentControl Classes="EgyptSandBackground">
    <Grid>
        <Border Background="{DynamicResource ColorSurface}"
                BorderBrush="{DynamicResource ColorBorder}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusCard}"
                Margin="40"
                MaxWidth="950"
                MaxHeight="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid ColumnDefinitions="*, Auto, 380">
                <Border Grid.Column="0" 
                        Background="#0A192A" 
                        CornerRadius="4,0,0,4"
                        ClipToBounds="True">
                    <Grid>
                        <Image Stretch="UniformToFill"
                               Opacity="0.45"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        
                        <StackPanel VerticalAlignment="Bottom" Margin="35" Spacing="6">
                            <TextBlock Classes="brand-title"
                                       Text="{Binding [Menu.Title], Source={x:Static loc:LocalizationManager.Instance}}"
                                       Foreground="{DynamicResource ColorTextLight}"
                                       FontSize="38"/>
                            
                            <TextBlock Text="{Binding [Menu.Subtitle], Source={x:Static loc:LocalizationManager.Instance}}"
                                       Foreground="#94A3B8"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       FontWeight="Normal"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <Border Grid.Column="1" 
                        Width="1" 
                        Background="{DynamicResource ColorBorder}"/>


                <Grid Grid.Column="2" Margin="35,30" VerticalAlignment="Center">
                    <StackPanel Spacing="16">
                        
                        <TextBlock Text="{Binding [AccessMenu.WelcomeMessage], Source={x:Static loc:LocalizationManager.Instance}}" 
                                   Foreground="{DynamicResource ColorTextPrimary}"
                                   FontSize="{DynamicResource FontSizeTitle}" 
                                   FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding [AccessMenu.Username], Source={x:Static loc:LocalizationManager.Instance}}"
                                       Foreground="{DynamicResource ColorTextSecondary}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontWeight="Medium"/>
                            <TextBox Text="{Binding Username}" 
                                     Watermark="{Binding [AccessMenu.Username], Source={x:Static loc:LocalizationManager.Instance}}"
                                     CornerRadius="{DynamicResource RadiusSmall}"
                                     BorderBrush="{DynamicResource ColorBorderFocus}"
                                     FontSize="{DynamicResource FontSizeBody}"
                                     Padding="12,8"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding [AccessMenu.Password], Source={x:Static loc:LocalizationManager.Instance}}"
                                       Foreground="{DynamicResource ColorTextSecondary}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       FontWeight="Medium"/>
                            <TextBox Text="{Binding Password}"
                                     PasswordChar="*"
                                     Watermark="{Binding [AccessMenu.Password], Source={x:Static loc:LocalizationManager.Instance}}"
                                     CornerRadius="{DynamicResource RadiusSmall}"
                                     BorderBrush="{DynamicResource ColorBorderFocus}"
                                     FontSize="{DynamicResource FontSizeBody}"
                                     Padding="12,8"/>
                        </StackPanel>
                        
                        <Button Content="{Binding [AccessMenu.ForgottenPassword], Source={x:Static loc:LocalizationManager.Instance}}" 
                                Background="Transparent" 
                                Foreground="{DynamicResource ColorPrimaryHover}" 
                                FontSize="{DynamicResource FontSizeSmall}"
                                FontWeight="Medium"
                                Cursor="Hand" 
                                HorizontalAlignment="Right"
                                Padding="0"
                                Margin="0,-4,0,2"/>
                        
                        <TextBlock Text="{Binding StatusMessage}" 
                                   IsVisible="{Binding HasStatusMessage}"
                                   Foreground="#E53935" 
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>
                        
                        <Button Classes="primary-btn"
                                Command="{Binding LoginCommand}"
                                Content="{Binding [AccessMenu.LogIn], Source={x:Static loc:LocalizationManager.Instance}}" 
                                HorizontalAlignment="Stretch"
                                Height="42"
                                FontSize="15"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5" Margin="0,2,0,0">
                            <TextBlock Text="{Binding [AccessMenu.NewAccountMessage], Source={x:Static loc:LocalizationManager.Instance}}" 
                                       Foreground="{DynamicResource ColorTextSecondary}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       VerticalAlignment="Center"/>
                            <Button Content="{Binding [AccessMenu.CreateAccount], Source={x:Static loc:LocalizationManager.Instance}}" 
                                    Background="Transparent" 
                                    Foreground="{DynamicResource ColorPrimaryHover}" 
                                    FontSize="{DynamicResource FontSizeSmall}"
                                    FontWeight="SemiBold"
                                    Cursor="Hand" 
                                    Padding="0"/>
                        </StackPanel>
                        
                        <Border Height="1" 
                                Background="{DynamicResource ColorBorder}" 
                                Margin="0,4"/>
                        
                        <Button Classes="outline-btn"
                                Content="{Binding [AccessMenu.PlayAsGuest], Source={x:Static loc:LocalizationManager.Instance}}" 
                                Command="{Binding NavigateToPlayAsGuestCommand}"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                FontSize="14"/>

                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
    </Grid>
    </ContentControl>

</UserControl>