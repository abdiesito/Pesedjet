<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pesedjet.Client.ViewModels"
             xmlns:loc="using:Pesedjet.Client.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="500"
             x:Class="Pesedjet.Client.Views.CreateMatchView"
             x:DataType="vm:CreateMatchViewModel"
             x:CompileBindings="False">

    <Design.DataContext>
        <vm:CreateMatchViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Título de la Sección -->
        <TextBlock Grid.Row="0"
                   Text="{Binding [PlaySection.ConfigureMatch], Source={x:Static loc:LocalizationManager.Instance}}"
                   Foreground="{DynamicResource ColorTextPrimary}"
                   FontSize="{DynamicResource FontSizeTitle}"
                   FontWeight="Bold"
                   Margin="0,0,0,28"/>

        <!-- Formulario de Configuración -->
        <StackPanel Grid.Row="1" Spacing="24" VerticalAlignment="Top">
            
            <!-- 1. Cantidad de Jugadores -->
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding [PlaySection.PlayerCount], Source={x:Static loc:LocalizationManager.Instance}}"
                           Foreground="{DynamicResource ColorTextSecondary}"
                           FontSize="15"
                           FontWeight="Medium"/>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="2" Width="50" Height="42" IsChecked="True"/>
                    <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="3" Width="50" Height="42"/>
                    <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="4" Width="50" Height="42"/>
                    <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="5" Width="50" Height="42"/>
                    <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="6" Width="50" Height="42"/>
                </StackPanel>
            </StackPanel>

            <!-- 2. Tipo de Partida -->
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding [PlaySection.GameType], Source={x:Static loc:LocalizationManager.Instance}}"
                           Foreground="{DynamicResource ColorTextSecondary}"
                           FontSize="15"
                           FontWeight="Medium"/>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton Classes="option-chip" 
                                 GroupName="TypeGroup" 
                                 Content="{Binding [PlaySection.GameTypeStandard], Source={x:Static loc:LocalizationManager.Instance}}" 
                                 Width="120" 
                                 Height="42" 
                                 IsChecked="True"/>
                    <RadioButton Classes="option-chip" 
                                 GroupName="TypeGroup" 
                                 Content="{Binding [PlaySection.GameTypeQuick], Source={x:Static loc:LocalizationManager.Instance}}" 
                                 Width="120" 
                                 Height="42"/>
                </StackPanel>
            </StackPanel>

            <!-- 3. Alcance / Privacidad de la Sala -->
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding [PlaySection.RoomPrivacy], Source={x:Static loc:LocalizationManager.Instance}}"
                           Foreground="{DynamicResource ColorTextSecondary}"
                           FontSize="15"
                           FontWeight="Medium"/>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton Classes="option-chip" 
                                 GroupName="PrivacyGroup" 
                                 Content="{Binding [PlaySection.PublicScope], Source={x:Static loc:LocalizationManager.Instance}}" 
                                 Width="120" 
                                 Height="42" 
                                 IsChecked="True"/>
                    <RadioButton Classes="option-chip" 
                                 GroupName="PrivacyGroup" 
                                 Content="{Binding [PlaySection.PrivateScope], Source={x:Static loc:LocalizationManager.Instance}}" 
                                 Width="120" 
                                 Height="42"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>

        <!-- Botón Crear Sala -->
        <Button Grid.Row="2"
                Classes="primary-btn"
                Content="{Binding [PlaySection.ConfirmCreate], Source={x:Static loc:LocalizationManager.Instance}}"
                Height="46"
                Padding="32,0"
                FontSize="15"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"/>
    </Grid>

</UserControl>