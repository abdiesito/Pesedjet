<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pesedjet.Client.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
             x:Class="Pesedjet.Client.Views.CreateMatchView"
             x:DataType="vm:CreateMatchViewModel"
             Background="{DynamicResource ColorBackground}">

    <Design.DataContext>
        <vm:CreateMatchViewModel/>
    </Design.DataContext>
    
    <Border Background="{DynamicResource ColorSurface}"
            BorderBrush="{DynamicResource ColorBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusCard}"
            Margin="40"
            Padding="35">

        <Grid ColumnDefinitions="240, Auto, *">
            <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto">
                <Button Grid.Row="0"
                        Background="Transparent"
                        Command="{Binding GoBackCommand}"
                        Foreground="{DynamicResource ColorTextSecondary}"
                        FontSize="22"
                        FontWeight="Bold"
                        Padding="6"
                        HorizontalAlignment="Left"
                        Cursor="Hand">
                    &lt;
                </Button>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="16" Margin="0,0,25,0">
                    <Button Classes="primary-btn"
                            Height="50"
                            FontSize="16"
                            Content="Crear Sala"/>

                    <Button Classes="outline-btn"
                            Height="50"
                            FontSize="16"
                            Content="Unirse"/>
                </StackPanel>
            </Grid>
            
            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource ColorBorder}"
                    Margin="10,15,35,15"/>
            
            <Grid Grid.Column="2" RowDefinitions="Auto, *, Auto" Margin="10,0,10,0">
                <TextBlock Grid.Row="0"
                           Text="Configurar Partida"
                           Foreground="{DynamicResource ColorTextPrimary}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="Bold"
                           Margin="0,5,0,32"/>

                <StackPanel Grid.Row="1" Spacing="26" VerticalAlignment="Top">
                    <Grid ColumnDefinitions="140, *">
                        <TextBlock Grid.Column="0"
                                   Text="Jugadores:"
                                   Foreground="{DynamicResource ColorTextSecondary}"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="2" Width="44" Height="42" IsChecked="True"/>
                            <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="3" Width="44" Height="42"/>
                            <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="4" Width="44" Height="42"/>
                            <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="5" Width="44" Height="42"/>
                            <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="6" Width="44" Height="42"/>
                        </StackPanel>
                    </Grid>
                    
                    <Grid ColumnDefinitions="140, *">
                        <TextBlock Grid.Column="0"
                                   Text="Tipo de Partida:"
                                   Foreground="{DynamicResource ColorTextSecondary}"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                            <RadioButton Classes="option-chip" GroupName="TypeGroup" Content="Normal" Width="105" Height="42" IsChecked="True"/>
                            <RadioButton Classes="option-chip" GroupName="TypeGroup" Content="Rápida" Width="105" Height="42"/>
                        </StackPanel>
                    </Grid>
                    
                    <Grid ColumnDefinitions="140, *">
                        <TextBlock Grid.Column="0"
                                   Text="Privacidad:"
                                   Foreground="{DynamicResource ColorTextSecondary}"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                            <RadioButton Classes="option-chip" GroupName="PrivacyGroup" Content="Pública" Width="105" Height="42" IsChecked="True"/>
                            <RadioButton Classes="option-chip" GroupName="PrivacyGroup" Content="Privada" Width="105" Height="42"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                
                <Button Grid.Row="2"
                        Classes="primary-btn"
                        Content="Crear"
                        Width="140"
                        Height="46"
                        FontSize="16"
                        HorizontalAlignment="Right"
                        Margin="0,0,5,5"/>
            </Grid>
        </Grid>
    </Border>

</UserControl>