<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pesedjet.Client.ViewModels"
             xmlns:loc="using:Pesedjet.Client.Utilities"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="500"
             x:Class="Pesedjet.Client.Views.CreateMatchView"
             x:DataType="vm:CreateMatchViewModel"
             x:CompileBindings="False">

    <Design.DataContext>
        <vm:CreateMatchViewModel/>
    </Design.DataContext>
    
    <Border Background="{DynamicResource ColorSurface}"
            BorderBrush="{DynamicResource ColorBorder}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusCard}"
            Margin="40"
            Padding="35">

        <Grid ColumnDefinitions="240, Auto, *">
            
            <!-- Columna Izquierda: Botón de Regreso -->
            <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto">
                <Button Grid.Row="0"
                        Background="Transparent"
                        Command="{Binding GoBackCommand}"
                        Foreground="{DynamicResource ColorTextSecondary}"
                        FontSize="22"
                        FontWeight="Bold"
                        Padding="6"
                        HorizontalAlignment="Left"
                        Cursor="Hand">
                    &lt;
                </Button>
            </Grid>
            
            <!-- Separador -->
            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource ColorBorder}"
                    Margin="10,15,35,15"/>
            
            <!-- Columna Derecha: Formulario -->
            <Grid Grid.Column="2" RowDefinitions="Auto, *, Auto" Margin="10,0,10,0">
                <TextBlock Grid.Row="0"
                           Text="{Binding [PlaySection.ConfigureMatch], Source={x:Static loc:LocalizationManager.Instance}}"
                           Foreground="{DynamicResource ColorTextPrimary}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontWeight="Bold"
                           Margin="0,5,0,32"/>

                <StackPanel Grid.Row="1" Spacing="26" VerticalAlignment="Top">
                    
                    <!-- 1. Cantidad de Jugadores -->
                    <Grid ColumnDefinitions="140, *">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [PlaySection.PlayerCount], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Foreground="{DynamicResource ColorTextSecondary}"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="2" Width="44" Height="42" IsChecked="True"/>
                            <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="3" Width="44" Height="42"/>
                            <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="4" Width="44" Height="42"/>
                            <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="5" Width="44" Height="42"/>
                            <RadioButton Classes="option-chip" GroupName="PlayersGroup" Content="6" Width="44" Height="42"/>
                        </StackPanel>
                    </Grid>

                    <!-- 2. Tipo de Partida -->
                    <Grid ColumnDefinitions="140, *">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [PlaySection.GameType], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Foreground="{DynamicResource ColorTextSecondary}"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                            <RadioButton Classes="option-chip" 
                                         GroupName="TypeGroup" 
                                         Content="{Binding [PlaySection.GameTypeStandard], Source={x:Static loc:LocalizationManager.Instance}}" 
                                         Width="120" Height="42" IsChecked="True"/>
                            <RadioButton Classes="option-chip" 
                                         GroupName="TypeGroup" 
                                         Content="{Binding [PlaySection.GameTypeQuick], Source={x:Static loc:LocalizationManager.Instance}}" 
                                         Width="120" Height="42"/>
                        </StackPanel>
                    </Grid>
                    
                    <!-- 3. Alcance / Privacidad -->
                    <Grid ColumnDefinitions="140, *">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [PlaySection.RoomPrivacy], Source={x:Static loc:LocalizationManager.Instance}}"
                                   Foreground="{DynamicResource ColorTextSecondary}"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <RadioButton Classes="option-chip" 
                                         GroupName="PrivacyGroup" 
                                         Content="{Binding [PlaySection.PublicScope], Source={x:Static loc:LocalizationManager.Instance}}" 
                                         Width="120" Height="42" IsChecked="True"/>
                            <RadioButton Classes="option-chip" 
                                         GroupName="PrivacyGroup" 
                                         Content="{Binding [PlaySection.PrivateScope], Source={x:Static loc:LocalizationManager.Instance}}" 
                                         Width="120" Height="42"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                
                <Button Grid.Row="2"
                        Classes="primary-btn"
                        Content="{Binding [PlaySection.ConfirmCreate], Source={x:Static loc:LocalizationManager.Instance}}"
                        Height="46"
                        Padding="32,0"
                        FontSize="15"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>