<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pesedjet.Client.App"
             xmlns:local="using:Pesedjet.Client"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Pesedjet.Client/Styles/AppStyles.axaml" />
        <StyleInclude Source="avares://Pesedjet.Client/Styles/SandBackgroundStyle.axaml" />
        <StyleInclude Source="avares://Pesedjet.Client/Styles/ControlsStyles.axaml" />
    </Application.Styles>        
</Application>
